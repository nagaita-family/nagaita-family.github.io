rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // IMPORTANT: replace both UIDs in Firebase Console / deploy rules before use.
    // Until then, all family data is inaccessible.
    // Anonymous sign-in is silent, but NOT public access.
    // Only the two pre-approved anonymous UIDs can read/write family data.
    function enrolledAnonymous() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == "anonymous";
    }
    function naoya() {
      return enrolledAnonymous() && request.auth.uid == "REPLACE_WITH_NAOYA_AUTH_UID";
    }
    function shoko() {
      return enrolledAnonymous() && request.auth.uid == "REPLACE_WITH_SHOKO_AUTH_UID";
    }
    function role() {
      return naoya() ? "naoya" : (shoko() ? "shoko" : "none");
    }
    function personOK(p) {
      return p in ["naoya", "shoko", "miori", "kosuke"];
    }
    function locOK(x) {
      return x is map && x.keys().hasOnly(["lat","lon","accuracy","at"])
        && x.keys().hasAll(["lat","lon","accuracy","at"])
        && x.lat is number && x.lon is number && x.accuracy is number
        && x.lat >= -90 && x.lat <= 90 && x.lon >= -180 && x.lon <= 180
        && x.accuracy >= 0 && x.accuracy <= 100000
        && x.at is int && x.at > 1500000000000;
    }
    function validData(p) {
      let d = request.resource.data;
      return d.keys().hasOnly(["person","reporter","status","observedAt","location"])
        && d.keys().hasAll(["person","reporter","status","observedAt"])
        && d.person == p && d.reporter == role()
        && d.status in ["safe","help"]
        && d.observedAt is int && d.observedAt > 1500000000000
        && (!("location" in d) || locOK(d.location));
    }

    match /families/home/members/{person}/reports/{eventId} {
      allow get, list: if role() != "none" && personOK(person);
      allow create: if role() != "none" && personOK(person)
        && (person == role() || person in ["miori","kosuke"])
        && eventId.size() >= 10 && eventId.size() <= 80
        && validData(person);
      allow update: if role() != "none" && personOK(person)
        && resource.data.reporter == role()
        && request.resource.data.keys().hasOnly(["person","reporter","status","observedAt","location"])
        && (
          request.resource.data == resource.data
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["location"])
              && ("location" in request.resource.data)
              && locOK(request.resource.data.location))
        );
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
